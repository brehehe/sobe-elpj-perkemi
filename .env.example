APP_NAME="Smart e-LPJ SOBE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=smart_elpj
DB_USERNAME=smart_elpj
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
EVIDENCE_DISK=local
EVIDENCE_SCANNER=signature
EVIDENCE_MAX_SIZE_KB=20480
CLAMAV_BINARY=/usr/bin/clamscan
CLAMAV_TIMEOUT_SECONDS=60
QUEUE_CONNECTION=redis
DB_QUEUE_RETRY_AFTER=330
REDIS_QUEUE_RETRY_AFTER=330

CACHE_STORE=redis
CACHE_PREFIX=smart_elpj

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-sol
OPENAI_REASONING_EFFORT=high
OPENAI_PROMPT_VERSION=lpj-intelligence-v1
OPENAI_CONNECT_TIMEOUT=10
OPENAI_TIMEOUT=240
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=20000
OPENAI_VIDEO_FRAME_COUNT=48
OPENAI_VIDEO_FRAME_MAX_WIDTH=1280
OPENAI_VIDEO_FRAME_DETAIL=high
# Token harian; 0 menonaktifkan guard.
OPENAI_DAILY_BUDGET=0
OPENAI_MONTHLY_BUDGET=0
OPENAI_ENABLED=true

REVERB_APP_ID=smart-elpj-local
REVERB_APP_KEY=replace-with-public-app-key
REVERB_APP_SECRET=replace-with-private-app-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=
BACKUP_LAST_RESTORE_DRILL_AT=
BACKUP_RESTORE_DRILL_MAX_AGE_DAYS=90

APP_ENV_LABEL=development
APP_BACKEND_VERSION=0.1.0
APP_FRONTEND_VERSION=0.1.0
APP_BUILD_ID=development
APP_RELEASED_AT=
SYSTEM_OWNER_NAME="Sekretariat PB PERKEMI"
SYSTEM_SUPPORT_EMAIL=
SYSTEM_SECURITY_EMAIL=
SYSTEM_DOCUMENTATION_URL=
SYSTEM_PRIVACY_URL=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="Smart e-LPJ SOBE"
